# Copy to .env and change if you like. These are LOCAL-ONLY development values.
# Real secrets will live in Azure Key Vault (Phase 7), never in this repo.

POSTGRES_PASSWORD=shopflow

# SQL Server is only needed by the Service Bus emulator.
# It must be at least 8 characters with upper case, lower case, a number and a symbol.
MSSQL_SA_PASSWORD=ShopFlow_Local_2026!
